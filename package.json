    "hono": "^4.12.34",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "standardwebhooks": "1.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@truefoundry/trueforge": "0.1.4",
