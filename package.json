{
  "name": "paywallproof",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#domain": "./src/domain/index.ts",
    "#evidence": "./src/evidence/index.ts",
    "#evidence/*": "./src/evidence/*.ts",
    "#integrations/*": "./src/integrations/*.ts",
    "#reference": "./src/reference/index.ts",
    "#reference/*": "./src/reference/*.ts",
    "#repair": "./src/repair/index.ts",
    "#repair/*": "./src/repair/*.ts",
    "#run": "./src/run/index.ts"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "dev:target": "next dev apps/demo-saas --hostname 127.0.0.1 --port 3001",
    "dev:polar-webhook-relay": "tsx scripts/start-polar-webhook-relay.ts",
    "dev:polar": "tsx scripts/start-polar-development.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:repository": "node scripts/check-repository-shape.mjs",
    "check:delivery": "node scripts/check-delivery.mjs",
    "check:skill": "node scripts/validate-review-skill.mjs",
    "test:turn-selection": "node scripts/run-contract.mjs turn-selection",
    "test:evidence-review": "node scripts/run-contract.mjs evidence-review",
    "test:evidence-review:live": "tsx scripts/verify-evidence-review.ts",
    "verify:ci": "node scripts/verify-repository.mjs",
    "verify": "node scripts/verify-repository.mjs --live",
    "test": "vitest run",
    "test:acceptance": "vitest run tests/acceptance",
    "test:polar": "tsx scripts/verify-polar.ts",
    "test:polar:lifecycle": "tsx scripts/verify-polar-workflow.ts",
    "polar:webhook:create": "tsx scripts/configure-polar-webhook.ts",
    "polar:webhook:delete": "tsx scripts/delete-polar-webhook.ts",
    "test:runtime": "tsx scripts/verify-runtime.ts",
    "model:codex": "tsx scripts/configure-codex-model.ts",
    "dev:codex-model": "tsx scripts/start-codex-model.ts",
    "test:repair": "tsx scripts/verify-repair.ts",
    "demo:reset": "tsx scripts/reset-reference.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "better-sqlite3": "13.0.2",
    "hono": "^4.12.34",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "standardwebhooks": "1.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@truefoundry/trueforge": "0.1.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "fast-check": "^4.5.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "4.1.11"
  }
}
